# ulei uncertain alerter (user unit, ADR-0097 section 5): `ulei-tg uncertain` runs once and exits.
# It asks the owner inbox for its uncertain events over C1 and tells the owner through the Bot API
# when they are new, every 24 h while any stay, and when the inbox cannot be read. It writes only
# its state directory. ulei-uncertain.timer starts it; it has no [Install].
[Unit]
Description=ulei uncertain alerter
# Not pulled in: a run with the inbox down tells the owner so.
After=ulei-inbox.service

[Service]
# Beside ulei-tg, outside any IO-capped slice (ADR-0042 section 11).
Slice=ulei.slice
Type=oneshot
Environment=ULEI_CONFIG=%E/ulei/ulei.toml
ExecStart=%h/.local/bin/ulei-tg uncertain --state %S/ulei/uncertain/state.json
# One C1 call and a notice of at most nine messages per owner chat with their retries.
TimeoutStartSec=5min
StateDirectory=ulei/uncertain
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/ulei/uncertain
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
UMask=0077
MemoryMax=32M
TasksMax=4
