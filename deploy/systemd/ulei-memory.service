# ulei archive (user unit, ADR-0042, ADR-0070): serves C10 on memory.socket and pulls the
# engine's dialogue over engine.c6_socket at start, before each search and on sync. Writes only
# the directory of memory.archive and the socket directory.
[Unit]
Description=ulei archive
# Ordered after the engine so the first pull finds its socket, but not pulled in: the daemon
# starts without the engine, and health names the failed pull.
After=ulei-engine.service
StartLimitIntervalSec=0

[Service]
Type=exec
Environment=ULEI_CONFIG=%E/ulei/ulei.toml
ExecStart=%h/.local/bin/ulei-memory serve
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
RestartPreventExitStatus=2
StateDirectory=ulei/memory
StateDirectoryMode=0700
# Shared with ulei-engine.service and ulei-inbox.service, so a stop of one unit keeps the
# others' sockets.
RuntimeDirectory=ulei
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/ulei/memory %t/ulei
PrivateTmp=yes
# Its own socket and the engine's C6 socket; no network.
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
UMask=0077
# The daemon's own memory stays within the 4 MiB VmHWM budget (ADR-0051 section 7); the rest
# is page cache, which the cgroup charges. The index pages of a multi-GB archive must stay warm:
# under 32M they were reclaimed all the time and a cold health took about 30 s. Above
# MemoryHigh the kernel reclaims cache first; MemoryMax is the hard stop (ADR-0081).
# One thread, doubled.
MemoryHigh=128M
MemoryMax=256M
TasksMax=2

[Install]
WantedBy=default.target
