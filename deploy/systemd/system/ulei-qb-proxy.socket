# The stable socket of the qb gateway for the engine's system unit system/ulei-engine.service
# (ADR-0069 section 2): that unit binds this socket's directory over the gateway's socket
# directory /run/user/<ULEI_UID>/qb-gateway, and ulei-qb-proxy.service relays each connection to
# the gateway's socket. The directory is root's and outlives any re-creation of the gateway's.
#
# Fill <ULEI_USER> (sed, docs/runbooks/mvp-pilot-cutover.md part 6) and install as
# /etc/systemd/system/ulei-qb-proxy.socket (root, 0644) beside ulei-qb-proxy.service.
[Unit]
Description=qb gateway socket of the ulei engine (system unit of <ULEI_USER>)

[Socket]
ListenStream=/run/ulei-qb-proxy/gateway.sock
SocketUser=<ULEI_USER>
SocketGroup=<ULEI_USER>
SocketMode=0600
DirectoryMode=0755

[Install]
WantedBy=sockets.target
