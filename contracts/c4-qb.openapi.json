{
  "openapi": "3.1.0",
  "info": {
    "title": "qb /v1 API",
    "version": "0.3.0",
    "description": "C4: API of qb (pasekahq/quota-balancer), a class-1 product. VENDORED: transcribed from crates/qb-proto/src/lib.rs at qb commit a6442c57ea8237028288c33f7b13a5b8a9c54ccc (qb publishes an OpenAPI file only for its model gateway, vendored as C4G). The source of truth is the qb repository; update only together with the pin in ecosystem.lock. Transport: HTTP/1.1 JSON over a unix socket, peer identified by SO_PEERCRED. Timestamps are Unix seconds; fractions are 0.0..=1.0. Requests reject unknown fields; responses may grow optional fields within v1."
  },
  "x-ulei-vendored": {
    "product": "qb",
    "repo": "https://github.com/pasekahq/quota-balancer",
    "commit": "a6442c57ea8237028288c33f7b13a5b8a9c54ccc",
    "from": "crates/qb-proto/src/lib.rs, docs/api.md"
  },
  "paths": {
    "/v1/pick": {
      "post": {
        "operationId": "pick",
        "summary": "Which vendor/model/login to run a task on.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PickResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/report": {
      "post": {
        "operationId": "report",
        "summary": "Report an outcome or fresh quota windows.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/state": {
      "get": {
        "operationId": "state",
        "summary": "Snapshot of logins, windows and leases.",
        "responses": {
          "200": {
            "description": "Snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/why/{lease_id}": {
      "get": {
        "operationId": "why",
        "summary": "Why a live lease was granted, and its login now; 404 for a lease that is unknown, released or expired.",
        "parameters": [
          {
            "name": "lease_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lease.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhyResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness and version.",
        "responses": {
          "200": {
            "description": "Alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/roles": {
      "get": {
        "operationId": "roles",
        "summary": "The roles qbd runs since its start or its last reload; every identified caller may read it.",
        "responses": {
          "200": {
            "description": "Roles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RolesResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent/next": {
      "post": {
        "operationId": "agent_next",
        "summary": "An agent waits for a probe job; only clients listed in `[probe] agents`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentNextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentJob"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent/result": {
      "post": {
        "operationId": "agent_result",
        "summary": "An agent answers a probe job.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/roles": {
      "get": {
        "operationId": "admin_roles",
        "summary": "The roles of qbd's config file and its `roles_file` as they are on disk; admin clients only, 403 `forbidden` for another caller, 500 `internal` for a file that cannot be read or does not validate.",
        "responses": {
          "200": {
            "description": "Roles on disk.",
            "headers": {
              "ETag": {
                "description": "The roles file's hex SHA-256 in double quotes.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRoles"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "admin_roles_put",
        "summary": "Replace the `roles_file` with the roles of the body and make them the running roles; admin clients only. 404 `not_found` without a `roles_file`, 428 `precondition_required` without `If-Match`, 412 `precondition_failed` for another hash, 400 `bad_request` for a body or roles refused, 500 `internal` for a file that cannot be read or written.",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "The roles file's hex SHA-256 as `GET` answered it, with or without the double quotes of its `ETag`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminRolesPut"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Written, or unchanged when the roles change no byte.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRolesWritten"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/reload": {
      "post": {
        "operationId": "admin_reload",
        "summary": "qbd reads its config files again as on SIGHUP; the body is ignored. Admin clients only; 400 `bad_request` for a reload refused, and nothing changes.",
        "responses": {
          "200": {
            "description": "Reloaded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminReloadAnswer"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/logins/reset": {
      "post": {
        "operationId": "admin_logins_reset",
        "summary": "Clears the `auth_stale` or `auth_dead` mark of each login in `logins`, or of every declared login with `all`; other marks stay. Admin clients only; 400 `bad_request` when not exactly one of `logins` and `all` is given, 404 `not_found` for an undeclared login, and nothing is cleared.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginsReset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The logins asked for, in request order or, with `all`, in declaration order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminLoginsResetAnswer"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PickRequest": {
        "type": "object",
        "description": "POST /v1/pick request. Exactly one of `difficulty` and `pin` must be set.",
        "properties": {
          "role": {
            "type": "string",
            "description": "Role of the work, e.g. `worker`, `reviewer`, `observer`."
          },
          "difficulty": {
            "type": "integer",
            "description": "Difficulty step on the configured ladder (0 = cheapest).",
            "minimum": 0,
            "maximum": 255
          },
          "pin": {
            "$ref": "#/components/schemas/Pin"
          },
          "resume_of": {
            "type": "string",
            "description": "Run id of a session being resumed."
          },
          "avoid_vendor": {
            "type": "string",
            "description": "Vendor to avoid (independent review)."
          },
          "need": {
            "type": "array",
            "description": "Required capabilities. Accepted but not used yet: no candidate declares capabilities, so it filters nothing.",
            "items": {
              "type": "string",
              "description": "Capability."
            }
          },
          "expected_minutes": {
            "type": "integer",
            "description": "Expected duration of the task.",
            "minimum": 0
          },
          "run_id": {
            "type": "string",
            "description": "Caller's id of the run."
          },
          "on_behalf_of": {
            "type": "string",
            "description": "End client a relaying caller picks for, echoed into the lease and the journal; 1 to 128 bytes.",
            "minLength": 1,
            "maxLength": 128
          },
          "logins": {
            "type": "array",
            "description": "Allow-list of logins: a `run` lands only on one of them; 1 to 32 distinct names, each a declared login.",
            "items": {
              "type": "string",
              "description": "Login name."
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false
      },
      "Pin": {
        "type": "object",
        "description": "An exact vendor/model choice.",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "Vendor id."
          },
          "model": {
            "type": "string",
            "description": "Model name."
          },
          "effort": {
            "type": "string",
            "description": "Reasoning effort."
          },
          "login": {
            "type": "string",
            "description": "Restrict to one login."
          }
        },
        "required": [
          "vendor",
          "model"
        ],
        "additionalProperties": false
      },
      "Decision": {
        "type": "string",
        "description": "What the client should do.",
        "enum": [
          "run",
          "wait",
          "dead"
        ]
      },
      "PickResponse": {
        "type": "object",
        "description": "POST /v1/pick response.",
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "reason": {
            "type": "string",
            "description": "Machine-readable reason."
          },
          "lease_id": {
            "type": "string",
            "description": "Lease to report against (decision = run)."
          },
          "vendor": {
            "type": "string",
            "description": "Chosen vendor."
          },
          "model": {
            "type": "string",
            "description": "Chosen model."
          },
          "effort": {
            "type": "string",
            "description": "Chosen effort."
          },
          "login": {
            "type": "string",
            "description": "Chosen login."
          },
          "tier": {
            "type": "integer",
            "description": "Ladder tier of the choice.",
            "minimum": 0,
            "maximum": 255
          },
          "retry_after": {
            "type": "integer",
            "description": "When to ask again (decision = wait).",
            "minimum": 0
          },
          "stale": {
            "type": "boolean",
            "description": "The quota data behind the decision is older than its TTL."
          },
          "quota_snapshot_at": {
            "type": "integer",
            "description": "When the quota snapshot was observed.",
            "minimum": 0
          }
        },
        "required": [
          "decision",
          "reason"
        ]
      },
      "Outcome": {
        "type": "string",
        "description": "Outcome class a client reports for a run.",
        "enum": [
          "ok",
          "usage_limit",
          "rejected",
          "http_401",
          "http_429",
          "model_unavailable",
          "error"
        ]
      },
      "WindowReport": {
        "type": "object",
        "description": "One quota window observed in the vendor stream.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Window name."
          },
          "utilization": {
            "type": "number",
            "description": "Used fraction.",
            "minimum": 0,
            "maximum": 1
          },
          "resets_at": {
            "type": "integer",
            "description": "Reset time.",
            "minimum": 0
          },
          "length_s": {
            "type": "integer",
            "description": "Window length in seconds.",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "utilization"
        ],
        "additionalProperties": false
      },
      "ReportRequest": {
        "type": "object",
        "description": "POST /v1/report request. At least one of `lease_id` and `login` must be set.",
        "properties": {
          "lease_id": {
            "type": "string",
            "description": "Lease the report is about."
          },
          "login": {
            "type": "string",
            "description": "Login the report is about."
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "model": {
            "type": "string",
            "description": "Model the outcome applies to."
          },
          "windows": {
            "type": "array",
            "description": "Fresh windows.",
            "items": {
              "$ref": "#/components/schemas/WindowReport"
            }
          },
          "release": {
            "type": "boolean",
            "description": "The run is over; release the lease."
          },
          "credential": {
            "type": "string",
            "description": "Fingerprint of the credential the reported request used: 8 to 64 lowercase hex digits of a hash, never the secret. An `auth_stale` or `auth_dead` mark keeps the fingerprint it was reported with; a report of another fingerprint clears the mark first.",
            "pattern": "^[0-9a-f]{8,64}$"
          }
        },
        "required": [
          "outcome"
        ],
        "additionalProperties": false
      },
      "LoginStatus": {
        "type": "string",
        "description": "Health of a login.",
        "enum": [
          "ok",
          "rate_limited",
          "exhausted",
          "auth_stale",
          "auth_dead",
          "unknown"
        ]
      },
      "ReportResponse": {
        "type": "object",
        "description": "POST /v1/report response.",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "The report was applied."
          },
          "login_status": {
            "$ref": "#/components/schemas/LoginStatus"
          }
        },
        "required": [
          "accepted",
          "login_status"
        ]
      },
      "Source": {
        "type": "string",
        "description": "Where a window value came from.",
        "enum": [
          "stream",
          "probe",
          "assumed"
        ]
      },
      "WindowState": {
        "type": "object",
        "description": "A window in the state snapshot.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Window name."
          },
          "used": {
            "type": "number",
            "description": "Used fraction."
          },
          "reserved": {
            "type": "number",
            "description": "Fraction held by live leases."
          },
          "resets_at": {
            "type": "integer",
            "description": "Reset time.",
            "minimum": 0
          },
          "observed_at": {
            "type": "integer",
            "description": "When observed.",
            "minimum": 0
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "stale": {
            "type": "boolean",
            "description": "Older than its TTL."
          }
        },
        "required": [
          "name",
          "used",
          "reserved",
          "observed_at",
          "source",
          "stale"
        ]
      },
      "LoginState": {
        "type": "object",
        "description": "A login in the state snapshot.",
        "properties": {
          "login": {
            "type": "string",
            "description": "Login id."
          },
          "vendor": {
            "type": "string",
            "description": "Vendor id."
          },
          "status": {
            "$ref": "#/components/schemas/LoginStatus"
          },
          "dead_until": {
            "type": "integer",
            "description": "Dead or backed off until.",
            "minimum": 0
          },
          "windows": {
            "type": "array",
            "description": "Known windows.",
            "items": {
              "$ref": "#/components/schemas/WindowState"
            }
          }
        },
        "required": [
          "login",
          "vendor",
          "status",
          "windows"
        ]
      },
      "LeaseState": {
        "type": "object",
        "description": "A live lease.",
        "properties": {
          "lease_id": {
            "type": "string",
            "description": "Lease id."
          },
          "login": {
            "type": "string",
            "description": "Login."
          },
          "model": {
            "type": "string",
            "description": "Model."
          },
          "client": {
            "type": "string",
            "description": "Client that took the lease."
          },
          "run_id": {
            "type": "string",
            "description": "Caller's run id from the pick request."
          },
          "on_behalf_of": {
            "type": "string",
            "description": "End client the pick request named in `on_behalf_of`."
          },
          "expires_at": {
            "type": "integer",
            "description": "When the lease expires unless released first.",
            "minimum": 0
          }
        },
        "required": [
          "lease_id",
          "login",
          "model",
          "client",
          "expires_at"
        ]
      },
      "StateResponse": {
        "type": "object",
        "description": "GET /v1/state response.",
        "properties": {
          "api_version": {
            "type": "string",
            "description": "API version."
          },
          "now": {
            "type": "integer",
            "description": "Server time.",
            "minimum": 0
          },
          "logins": {
            "type": "array",
            "description": "Logins.",
            "items": {
              "$ref": "#/components/schemas/LoginState"
            }
          },
          "leases": {
            "type": "array",
            "description": "Live leases.",
            "items": {
              "$ref": "#/components/schemas/LeaseState"
            }
          }
        },
        "required": [
          "api_version",
          "now",
          "logins",
          "leases"
        ]
      },
      "WindowCost": {
        "type": "object",
        "description": "The fraction a lease reserves in one window of its login.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Window name."
          },
          "cost": {
            "type": "number",
            "description": "Reserved fraction."
          }
        },
        "required": [
          "name",
          "cost"
        ]
      },
      "WhyResponse": {
        "type": "object",
        "description": "GET /v1/why/{lease_id} response: a live lease, why it was granted and its login now.",
        "properties": {
          "lease_id": {
            "type": "string",
            "description": "Lease id."
          },
          "login": {
            "type": "string",
            "description": "Login the lease holds."
          },
          "model": {
            "type": "string",
            "description": "Model of the lease."
          },
          "client": {
            "type": "string",
            "description": "Client that took the lease."
          },
          "run_id": {
            "type": "string",
            "description": "Caller's run id from the pick request."
          },
          "on_behalf_of": {
            "type": "string",
            "description": "End client the pick request named in `on_behalf_of`."
          },
          "expires_at": {
            "type": "integer",
            "description": "When the lease expires unless released first.",
            "minimum": 0
          },
          "cost": {
            "type": "array",
            "description": "Reservation per window of the login's vendor, in declaration order.",
            "items": {
              "$ref": "#/components/schemas/WindowCost"
            }
          },
          "reason": {
            "type": "string",
            "description": "The pick `reason` the lease was granted with; absent when the journal did not keep it."
          },
          "login_state": {
            "$ref": "#/components/schemas/LoginState"
          }
        },
        "required": [
          "lease_id",
          "login",
          "model",
          "client",
          "expires_at",
          "cost",
          "login_state"
        ]
      },
      "AgentNextRequest": {
        "type": "object",
        "description": "POST /v1/agent/next request.",
        "properties": {
          "logins": {
            "type": "array",
            "description": "Logins this agent can probe, by config name.",
            "items": {
              "type": "string",
              "description": "Login."
            }
          }
        },
        "required": [
          "logins"
        ],
        "additionalProperties": false
      },
      "AgentJob": {
        "type": "object",
        "description": "POST /v1/agent/next response: probe one login now.",
        "properties": {
          "probe_id": {
            "type": "string",
            "description": "Id the result must name."
          },
          "login": {
            "type": "string",
            "description": "Login to probe."
          }
        },
        "required": [
          "probe_id",
          "login"
        ]
      },
      "ProbeOutcome": {
        "type": "string",
        "description": "What an agent's probe of a usage endpoint returned.",
        "enum": [
          "ok",
          "http_401",
          "http_429",
          "error"
        ]
      },
      "AgentResultRequest": {
        "type": "object",
        "description": "POST /v1/agent/result request.",
        "properties": {
          "probe_id": {
            "type": "string",
            "description": "The job's `probe_id`."
          },
          "outcome": {
            "$ref": "#/components/schemas/ProbeOutcome"
          },
          "windows": {
            "type": "array",
            "description": "Windows of an `ok` outcome.",
            "items": {
              "$ref": "#/components/schemas/WindowReport"
            }
          },
          "retry_after_s": {
            "type": "integer",
            "description": "The vendor's `Retry-After` in seconds, for `http_429`.",
            "minimum": 0
          }
        },
        "required": [
          "probe_id",
          "outcome"
        ],
        "additionalProperties": false
      },
      "HealthStatus": {
        "type": "string",
        "description": "Liveness.",
        "enum": [
          "ok"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "description": "GET /v1/health response.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "api_version": {
            "type": "string",
            "description": "API version."
          },
          "version": {
            "type": "string",
            "description": "Server build version."
          },
          "uptime_s": {
            "type": "integer",
            "description": "Seconds since start.",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "api_version",
          "version",
          "uptime_s"
        ]
      },
      "RolesSource": {
        "type": "string",
        "description": "Which file of qbd holds the roles: the `roles_file` the config names, or the config file itself as `[[roles]]` tables.",
        "enum": [
          "roles_file",
          "config"
        ]
      },
      "AdminRoles": {
        "type": "object",
        "description": "GET /v1/admin/roles response: the roles of qbd's files on disk.",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/RolesSource"
          },
          "file": {
            "type": "string",
            "description": "Path of that file."
          },
          "sha256": {
            "type": "string",
            "description": "Hex SHA-256 of that file's bytes; also the answer's `ETag`.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "roles": {
            "type": "array",
            "description": "The roles in file order.",
            "items": {
              "$ref": "#/components/schemas/RoleConfig"
            }
          }
        },
        "required": [
          "source",
          "file",
          "sha256",
          "roles"
        ]
      },
      "RolesResponse": {
        "type": "object",
        "description": "GET /v1/roles response: the roles qbd runs since its start or last reload.",
        "properties": {
          "roles": {
            "type": "array",
            "description": "The roles in file order.",
            "items": {
              "$ref": "#/components/schemas/RoleConfig"
            }
          }
        },
        "required": [
          "roles"
        ]
      },
      "RoleConfig": {
        "type": "object",
        "description": "A role as its config file declares it; PUT /v1/admin/roles takes the same shape.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Role name."
          },
          "ladder": {
            "type": "array",
            "description": "Ladder steps in file order.",
            "items": {
              "$ref": "#/components/schemas/LadderStep"
            }
          },
          "reserves": {
            "type": "array",
            "description": "Reserves in file order; absent is none.",
            "items": {
              "$ref": "#/components/schemas/RoleReserve"
            }
          }
        },
        "required": [
          "name",
          "ladder"
        ],
        "additionalProperties": false
      },
      "LadderStep": {
        "type": "object",
        "description": "One ladder step of a role.",
        "properties": {
          "difficulty": {
            "type": "integer",
            "description": "Difficulty the step serves.",
            "minimum": 0,
            "maximum": 255
          },
          "candidates": {
            "type": "array",
            "description": "Candidates in preference order.",
            "items": {
              "$ref": "#/components/schemas/LadderCandidate"
            }
          }
        },
        "required": [
          "difficulty",
          "candidates"
        ],
        "additionalProperties": false
      },
      "LadderCandidate": {
        "type": "object",
        "description": "A vendor/model/effort combination of a ladder step.",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "Declared vendor."
          },
          "model": {
            "type": "string",
            "description": "Model name."
          },
          "effort": {
            "type": "string",
            "description": "Reasoning effort; absent when the file has none."
          },
          "tier": {
            "type": "integer",
            "description": "Tier; lower tiers are preferred.",
            "minimum": 0,
            "maximum": 255
          },
          "cost_per_minute": {
            "type": "number",
            "description": "Fraction of the vendor's shortest window one minute of work uses; absent when the file has none.",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "vendor",
          "model",
          "tier"
        ],
        "additionalProperties": false
      },
      "RoleReserve": {
        "type": "object",
        "description": "Fraction of a window a role keeps free at a difficulty.",
        "properties": {
          "difficulty": {
            "type": "integer",
            "description": "Difficulty of a ladder step of the role.",
            "minimum": 0,
            "maximum": 255
          },
          "window": {
            "type": "string",
            "description": "Window name."
          },
          "fraction": {
            "type": "number",
            "description": "Reserved fraction.",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "difficulty",
          "window",
          "fraction"
        ],
        "additionalProperties": false
      },
      "AdminRolesPut": {
        "type": "object",
        "description": "PUT /v1/admin/roles request: the roles that replace the `roles_file`, in the GET shape.",
        "properties": {
          "roles": {
            "type": "array",
            "description": "The roles in file order.",
            "items": {
              "$ref": "#/components/schemas/RoleConfig"
            }
          }
        },
        "required": [
          "roles"
        ],
        "additionalProperties": false
      },
      "AdminRolesWritten": {
        "type": "object",
        "description": "PUT /v1/admin/roles response.",
        "properties": {
          "sha256": {
            "type": "string",
            "description": "Hex SHA-256 of the roles file written and now running, or of the file left as it was.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "backup": {
            "type": "string",
            "description": "Path of the copy of the file it replaced; absent when the roles change no byte and nothing was written."
          }
        },
        "required": [
          "sha256"
        ]
      },
      "AdminReloadAnswer": {
        "type": "object",
        "description": "POST /v1/admin/reload response: the counts of the config now running.",
        "properties": {
          "roles": {
            "type": "integer",
            "description": "Roles of the new config.",
            "minimum": 0
          },
          "clients": {
            "type": "integer",
            "description": "Clients of the new config.",
            "minimum": 0
          }
        },
        "required": [
          "roles",
          "clients"
        ]
      },
      "AdminLoginsReset": {
        "type": "object",
        "description": "POST /v1/admin/logins/reset request: the logins whose `auth_stale` or `auth_dead` mark to clear, or `all` of them; exactly one of the two.",
        "properties": {
          "logins": {
            "type": "array",
            "description": "Declared logins, by config name.",
            "items": {
              "type": "string",
              "description": "Login name."
            }
          },
          "all": {
            "type": "boolean",
            "description": "Every declared login instead."
          }
        },
        "additionalProperties": false
      },
      "AdminLoginsResetAnswer": {
        "type": "object",
        "description": "POST /v1/admin/logins/reset response.",
        "properties": {
          "logins": {
            "type": "array",
            "description": "One entry per login asked for.",
            "items": {
              "$ref": "#/components/schemas/LoginReset"
            }
          }
        },
        "required": [
          "logins"
        ]
      },
      "LoginReset": {
        "type": "object",
        "description": "What a reset did to one login.",
        "properties": {
          "login": {
            "type": "string",
            "description": "Login name."
          },
          "cleared": {
            "type": "boolean",
            "description": "The login had an `auth_stale` or `auth_dead` mark, now cleared."
          },
          "status": {
            "$ref": "#/components/schemas/LoginStatus"
          }
        },
        "required": [
          "login",
          "cleared",
          "status"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "description": "Machine-readable error class.",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "length_required",
          "payload_too_large",
          "precondition_failed",
          "precondition_required",
          "too_many_requests",
          "internal"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "Body of every non-2xx response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Human-readable detail."
          }
        },
        "required": [
          "error",
          "message"
        ]
      }
    }
  }
}
