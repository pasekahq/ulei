{
  "openapi": "3.1.0",
  "info": {
    "title": "qb /v1 API",
    "version": "0.1.0",
    "description": "C4: API of qb (vladmesh/quota-balancer), a class-1 product. VENDORED: transcribed from crates/qb-proto/src/lib.rs at qb commit e4b36e2155ae031cee3fdb1e76645fdaab6351cf (qb publishes an OpenAPI file only for its model gateway, vendored as C4G). The source of truth is the qb repository; update only together with the pin in ecosystem.lock. Transport: HTTP/1.1 JSON over a unix socket, peer identified by SO_PEERCRED. Timestamps are Unix seconds; fractions are 0.0..=1.0. Requests reject unknown fields; responses may grow optional fields within v1."
  },
  "x-ulei-vendored": {
    "product": "qb",
    "repo": "https://github.com/vladmesh/quota-balancer",
    "commit": "e4b36e2155ae031cee3fdb1e76645fdaab6351cf",
    "from": "crates/qb-proto/src/lib.rs, docs/api.md"
  },
  "paths": {
    "/v1/pick": {
      "post": {
        "operationId": "pick",
        "summary": "Which vendor/model/login to run a task on.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PickResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/report": {
      "post": {
        "operationId": "report",
        "summary": "Report an outcome or fresh quota windows.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/state": {
      "get": {
        "operationId": "state",
        "summary": "Snapshot of logins, windows and leases.",
        "responses": {
          "200": {
            "description": "Snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/why/{lease_id}": {
      "get": {
        "operationId": "why",
        "summary": "Why a live lease was granted, and its login now; 404 for a lease that is unknown, released or expired.",
        "parameters": [
          {
            "name": "lease_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lease.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhyResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness and version.",
        "responses": {
          "200": {
            "description": "Alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent/next": {
      "post": {
        "operationId": "agent_next",
        "summary": "An agent waits for a probe job; only clients listed in `[probe] agents`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentNextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentJob"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent/result": {
      "post": {
        "operationId": "agent_result",
        "summary": "An agent answers a probe job.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PickRequest": {
        "type": "object",
        "description": "POST /v1/pick request. Exactly one of `difficulty` and `pin` must be set.",
        "properties": {
          "role": {
            "type": "string",
            "description": "Role of the work, e.g. `worker`, `reviewer`, `observer`."
          },
          "difficulty": {
            "type": "integer",
            "description": "Difficulty step on the configured ladder (0 = cheapest).",
            "minimum": 0,
            "maximum": 255
          },
          "pin": {
            "$ref": "#/components/schemas/Pin"
          },
          "resume_of": {
            "type": "string",
            "description": "Run id of a session being resumed."
          },
          "avoid_vendor": {
            "type": "string",
            "description": "Vendor to avoid (independent review)."
          },
          "need": {
            "type": "array",
            "description": "Required capabilities.",
            "items": {
              "type": "string",
              "description": "Capability."
            }
          },
          "expected_minutes": {
            "type": "integer",
            "description": "Expected duration of the task.",
            "minimum": 0
          },
          "run_id": {
            "type": "string",
            "description": "Caller's id of the run."
          },
          "on_behalf_of": {
            "type": "string",
            "description": "End client a relaying caller picks for, echoed into the lease and the journal; 1 to 128 bytes.",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false
      },
      "Pin": {
        "type": "object",
        "description": "An exact vendor/model choice.",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "Vendor id."
          },
          "model": {
            "type": "string",
            "description": "Model name."
          },
          "effort": {
            "type": "string",
            "description": "Reasoning effort."
          },
          "login": {
            "type": "string",
            "description": "Restrict to one login."
          }
        },
        "required": [
          "vendor",
          "model"
        ],
        "additionalProperties": false
      },
      "Decision": {
        "type": "string",
        "description": "What the client should do.",
        "enum": [
          "run",
          "wait",
          "dead"
        ]
      },
      "PickResponse": {
        "type": "object",
        "description": "POST /v1/pick response.",
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "reason": {
            "type": "string",
            "description": "Machine-readable reason."
          },
          "lease_id": {
            "type": "string",
            "description": "Lease to report against (decision = run)."
          },
          "vendor": {
            "type": "string",
            "description": "Chosen vendor."
          },
          "model": {
            "type": "string",
            "description": "Chosen model."
          },
          "effort": {
            "type": "string",
            "description": "Chosen effort."
          },
          "login": {
            "type": "string",
            "description": "Chosen login."
          },
          "tier": {
            "type": "integer",
            "description": "Ladder tier of the choice.",
            "minimum": 0,
            "maximum": 255
          },
          "retry_after": {
            "type": "integer",
            "description": "When to ask again (decision = wait).",
            "minimum": 0
          },
          "stale": {
            "type": "boolean",
            "description": "The quota data behind the decision is older than its TTL."
          },
          "quota_snapshot_at": {
            "type": "integer",
            "description": "When the quota snapshot was observed.",
            "minimum": 0
          }
        },
        "required": [
          "decision",
          "reason"
        ]
      },
      "Outcome": {
        "type": "string",
        "description": "Outcome class a client reports for a run.",
        "enum": [
          "ok",
          "usage_limit",
          "rejected",
          "http_401",
          "http_429",
          "model_unavailable",
          "error"
        ]
      },
      "WindowReport": {
        "type": "object",
        "description": "One quota window observed in the vendor stream.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Window name."
          },
          "utilization": {
            "type": "number",
            "description": "Used fraction.",
            "minimum": 0,
            "maximum": 1
          },
          "resets_at": {
            "type": "integer",
            "description": "Reset time.",
            "minimum": 0
          },
          "length_s": {
            "type": "integer",
            "description": "Window length in seconds.",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "utilization"
        ],
        "additionalProperties": false
      },
      "ReportRequest": {
        "type": "object",
        "description": "POST /v1/report request. At least one of `lease_id` and `login` must be set.",
        "properties": {
          "lease_id": {
            "type": "string",
            "description": "Lease the report is about."
          },
          "login": {
            "type": "string",
            "description": "Login the report is about."
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "model": {
            "type": "string",
            "description": "Model the outcome applies to."
          },
          "windows": {
            "type": "array",
            "description": "Fresh windows.",
            "items": {
              "$ref": "#/components/schemas/WindowReport"
            }
          },
          "release": {
            "type": "boolean",
            "description": "The run is over; release the lease."
          }
        },
        "required": [
          "outcome"
        ],
        "additionalProperties": false
      },
      "LoginStatus": {
        "type": "string",
        "description": "Health of a login.",
        "enum": [
          "ok",
          "rate_limited",
          "exhausted",
          "auth_stale",
          "auth_dead",
          "unknown"
        ]
      },
      "ReportResponse": {
        "type": "object",
        "description": "POST /v1/report response.",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "The report was applied."
          },
          "login_status": {
            "$ref": "#/components/schemas/LoginStatus"
          }
        },
        "required": [
          "accepted",
          "login_status"
        ]
      },
      "Source": {
        "type": "string",
        "description": "Where a window value came from.",
        "enum": [
          "stream",
          "probe",
          "assumed"
        ]
      },
      "WindowState": {
        "type": "object",
        "description": "A window in the state snapshot.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Window name."
          },
          "used": {
            "type": "number",
            "description": "Used fraction."
          },
          "reserved": {
            "type": "number",
            "description": "Fraction held by live leases."
          },
          "resets_at": {
            "type": "integer",
            "description": "Reset time.",
            "minimum": 0
          },
          "observed_at": {
            "type": "integer",
            "description": "When observed.",
            "minimum": 0
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "stale": {
            "type": "boolean",
            "description": "Older than its TTL."
          }
        },
        "required": [
          "name",
          "used",
          "reserved",
          "observed_at",
          "source",
          "stale"
        ]
      },
      "LoginState": {
        "type": "object",
        "description": "A login in the state snapshot.",
        "properties": {
          "login": {
            "type": "string",
            "description": "Login id."
          },
          "vendor": {
            "type": "string",
            "description": "Vendor id."
          },
          "status": {
            "$ref": "#/components/schemas/LoginStatus"
          },
          "dead_until": {
            "type": "integer",
            "description": "Dead or backed off until.",
            "minimum": 0
          },
          "windows": {
            "type": "array",
            "description": "Known windows.",
            "items": {
              "$ref": "#/components/schemas/WindowState"
            }
          }
        },
        "required": [
          "login",
          "vendor",
          "status",
          "windows"
        ]
      },
      "LeaseState": {
        "type": "object",
        "description": "A live lease.",
        "properties": {
          "lease_id": {
            "type": "string",
            "description": "Lease id."
          },
          "login": {
            "type": "string",
            "description": "Login."
          },
          "model": {
            "type": "string",
            "description": "Model."
          },
          "client": {
            "type": "string",
            "description": "Client that took the lease."
          },
          "run_id": {
            "type": "string",
            "description": "Caller's run id from the pick request."
          },
          "on_behalf_of": {
            "type": "string",
            "description": "End client the pick request named in `on_behalf_of`."
          },
          "expires_at": {
            "type": "integer",
            "description": "When the lease expires unless released first.",
            "minimum": 0
          }
        },
        "required": [
          "lease_id",
          "login",
          "model",
          "client",
          "expires_at"
        ]
      },
      "StateResponse": {
        "type": "object",
        "description": "GET /v1/state response.",
        "properties": {
          "api_version": {
            "type": "string",
            "description": "API version."
          },
          "now": {
            "type": "integer",
            "description": "Server time.",
            "minimum": 0
          },
          "logins": {
            "type": "array",
            "description": "Logins.",
            "items": {
              "$ref": "#/components/schemas/LoginState"
            }
          },
          "leases": {
            "type": "array",
            "description": "Live leases.",
            "items": {
              "$ref": "#/components/schemas/LeaseState"
            }
          }
        },
        "required": [
          "api_version",
          "now",
          "logins",
          "leases"
        ]
      },
      "WindowCost": {
        "type": "object",
        "description": "The fraction a lease reserves in one window of its login.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Window name."
          },
          "cost": {
            "type": "number",
            "description": "Reserved fraction."
          }
        },
        "required": [
          "name",
          "cost"
        ]
      },
      "WhyResponse": {
        "type": "object",
        "description": "GET /v1/why/{lease_id} response: a live lease, why it was granted and its login now.",
        "properties": {
          "lease_id": {
            "type": "string",
            "description": "Lease id."
          },
          "login": {
            "type": "string",
            "description": "Login the lease holds."
          },
          "model": {
            "type": "string",
            "description": "Model of the lease."
          },
          "client": {
            "type": "string",
            "description": "Client that took the lease."
          },
          "run_id": {
            "type": "string",
            "description": "Caller's run id from the pick request."
          },
          "on_behalf_of": {
            "type": "string",
            "description": "End client the pick request named in `on_behalf_of`."
          },
          "expires_at": {
            "type": "integer",
            "description": "When the lease expires unless released first.",
            "minimum": 0
          },
          "cost": {
            "type": "array",
            "description": "Reservation per window of the login's vendor, in declaration order.",
            "items": {
              "$ref": "#/components/schemas/WindowCost"
            }
          },
          "reason": {
            "type": "string",
            "description": "The pick `reason` the lease was granted with; absent when the journal did not keep it."
          },
          "login_state": {
            "$ref": "#/components/schemas/LoginState"
          }
        },
        "required": [
          "lease_id",
          "login",
          "model",
          "client",
          "expires_at",
          "cost",
          "login_state"
        ]
      },
      "AgentNextRequest": {
        "type": "object",
        "description": "POST /v1/agent/next request.",
        "properties": {
          "logins": {
            "type": "array",
            "description": "Logins this agent can probe, by config name.",
            "items": {
              "type": "string",
              "description": "Login."
            }
          }
        },
        "required": [
          "logins"
        ],
        "additionalProperties": false
      },
      "AgentJob": {
        "type": "object",
        "description": "POST /v1/agent/next response: probe one login now.",
        "properties": {
          "probe_id": {
            "type": "string",
            "description": "Id the result must name."
          },
          "login": {
            "type": "string",
            "description": "Login to probe."
          }
        },
        "required": [
          "probe_id",
          "login"
        ]
      },
      "ProbeOutcome": {
        "type": "string",
        "description": "What an agent's probe of a usage endpoint returned.",
        "enum": [
          "ok",
          "http_401",
          "http_429",
          "error"
        ]
      },
      "AgentResultRequest": {
        "type": "object",
        "description": "POST /v1/agent/result request.",
        "properties": {
          "probe_id": {
            "type": "string",
            "description": "The job's `probe_id`."
          },
          "outcome": {
            "$ref": "#/components/schemas/ProbeOutcome"
          },
          "windows": {
            "type": "array",
            "description": "Windows of an `ok` outcome.",
            "items": {
              "$ref": "#/components/schemas/WindowReport"
            }
          },
          "retry_after_s": {
            "type": "integer",
            "description": "The vendor's `Retry-After` in seconds, for `http_429`.",
            "minimum": 0
          }
        },
        "required": [
          "probe_id",
          "outcome"
        ],
        "additionalProperties": false
      },
      "HealthStatus": {
        "type": "string",
        "description": "Liveness.",
        "enum": [
          "ok"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "description": "GET /v1/health response.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "api_version": {
            "type": "string",
            "description": "API version."
          },
          "version": {
            "type": "string",
            "description": "Server build version."
          },
          "uptime_s": {
            "type": "integer",
            "description": "Seconds since start.",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "api_version",
          "version",
          "uptime_s"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "description": "Machine-readable error class.",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "length_required",
          "payload_too_large",
          "too_many_requests",
          "internal"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "Body of every non-2xx response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Human-readable detail."
          }
        },
        "required": [
          "error",
          "message"
        ]
      }
    }
  }
}
