{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulei.invalid/contracts/c2-mcp-tools.json",
  "title": "McpTools",
  "description": "C2 (draft): MCP tools the core exposes to any agent runtime (Claude Code, plugins of other runtimes, the Agent SDK engine). `x-tools` lists the tools; their input and output schemas are in `$defs`.",
  "x-tools": [
    {
      "name": "hive_create",
      "input": "#/$defs/HiveCreateInput",
      "output": "#/$defs/HiveCreateOutput"
    },
    {
      "name": "hive_show",
      "input": "#/$defs/CardRef",
      "output": "#/$defs/CardStatus"
    },
    {
      "name": "hive_list",
      "input": "#/$defs/HiveListInput",
      "output": "#/$defs/HiveListOutput"
    },
    {
      "name": "hive_steer",
      "input": "#/$defs/HiveSteerInput",
      "output": "#/$defs/Ack"
    },
    {
      "name": "hive_cancel",
      "input": "#/$defs/HiveCancelInput",
      "output": "#/$defs/Ack"
    },
    {
      "name": "garden_search",
      "input": "#/$defs/GardenSearchInput",
      "output": "#/$defs/GardenSearchOutput"
    },
    {
      "name": "garden_propose",
      "input": "#/$defs/GardenProposeInput",
      "output": "#/$defs/Ack"
    },
    {
      "name": "inbox_ack",
      "input": "#/$defs/InboxAckInput",
      "output": "#/$defs/Ack"
    },
    {
      "name": "gate_pending",
      "input": "#/$defs/Empty",
      "output": "#/$defs/GatePendingOutput"
    }
  ],
  "$defs": {
    "Empty": {
      "type": "object",
      "description": "No arguments.",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "Ack": {
      "type": "object",
      "description": "Generic acknowledgement.",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "The request was applied."
        },
        "message": {
          "type": "string",
          "description": "Optional human-readable detail."
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "CardRef": {
      "type": "object",
      "description": "Reference to a Hive card.",
      "properties": {
        "card_id": {
          "type": "string",
          "description": "Card id, e.g. `h_48b892d9`.",
          "pattern": "^h_[0-9a-f]{8}$"
        }
      },
      "required": [
        "card_id"
      ],
      "additionalProperties": false
    },
    "HiveCreateOutput": {
      "type": "object",
      "description": "The card a create made or found by its idempotency key.",
      "properties": {
        "card_id": {
          "type": "string",
          "description": "Card id, e.g. `h_48b892d9`.",
          "pattern": "^h_[0-9a-f]{8}$"
        },
        "created": {
          "type": "boolean",
          "description": "False when `idem_key` named an existing card."
        },
        "state": {
          "type": "string",
          "description": "Card state after the create."
        },
        "card_class": {
          "type": "string",
          "description": "The card's class as the hive stored it: `series_run` for a series (whose own card waits in `blocked` and makes one card per period).",
          "maxLength": 32
        },
        "owner_visible": {
          "type": "boolean",
          "description": "Whether the owner hears every result of the card."
        }
      },
      "required": [
        "card_id",
        "created",
        "state"
      ],
      "additionalProperties": false
    },
    "HiveCreateInput": {
      "type": "object",
      "description": "Create a Hive card: the fields of `hive.py create` a delegation may set. Exactly one of `acceptance` and `accept_review`. The caller is not an input: the server sets `created_by` from its config. No field names a script, an executor, a model, a delivery or a path; the result always comes back to the secretary through the owner inbox. Timing is the hive's own scheduler (ADR-0082): `not_before` holds a one-off card until a time (a reminder); `every` or `cron` (with `tz`) make a series that creates one card per period, bounded by `until` or `max_runs` (`every` needs one of them); `recheck_every` with `recheck_until` or `recheck_max` re-runs the acceptance of a done card and reports when it fails (a watcher of a condition). Times are RFC 3339 with an offset, durations `Ns`, `Nm`, `Nh` or `Nd`.",
      "properties": {
        "title": {
          "type": "string",
          "description": "Short title.",
          "minLength": 1,
          "maxLength": 200
        },
        "goal": {
          "type": "string",
          "description": "What the head must achieve.",
          "minLength": 1,
          "maxLength": 8000
        },
        "details": {
          "type": "string",
          "description": "Further context for the head, the card's body (`--body`).",
          "maxLength": 32000
        },
        "acceptance": {
          "type": "string",
          "description": "Mechanical acceptance: a bash command run in the card workspace, exit 0 = pass. A bare `test -s REPORT.md` needs `review`.",
          "minLength": 1,
          "maxLength": 2000
        },
        "accept_review": {
          "type": "string",
          "description": "Review criteria a judge checks the report against, instead of `acceptance` (`--accept-review`); implies `review`.",
          "minLength": 1,
          "maxLength": 4000
        },
        "step": {
          "type": "integer",
          "description": "Difficulty step 1..5.",
          "minimum": 1,
          "maximum": 5
        },
        "source": {
          "type": "string",
          "description": "Where the request came from (`--source`), such as `msg:<id>`, `issue:<n>` or `manual`.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "description": "Card class (`--kind`); default `owner_task`. Leave it out with `every` or `cron`: a series is `series_run`.",
          "enum": [
            "owner_task",
            "system",
            "followup"
          ]
        },
        "review": {
          "type": "boolean",
          "description": "Independent review by the other vendor."
        },
        "hold": {
          "type": "boolean",
          "description": "Park the card until the owner runs `hive.py release`. Not with `not_before`, `every` or `cron`."
        },
        "owner_visible": {
          "type": "boolean",
          "description": "Notify the owner about the result; default by class. A series (`series_run`) reports only news unless this is true."
        },
        "idem_key": {
          "type": "string",
          "description": "Idempotency key of the request: a second create with it returns the first card.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$"
        },
        "not_before": {
          "type": "string",
          "description": "Hold the card until this time, then run it once (`--not-before`): RFC 3339 with an offset, such as `2026-11-27T09:00:00+03:00`. With `every` or `cron` the first period starts then. Not with `hold`.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "every": {
          "type": "string",
          "description": "Make a series: one card per period of this length (`--every`), `Ns`, `Nm`, `Nh` or `Nd` up to 366 days, such as `15m`. Needs `until` or `max_runs`; not with `cron`, `kind`, `hold` or a recheck.",
          "pattern": "^[1-9][0-9]{0,6}[smhd]$"
        },
        "cron": {
          "type": "string",
          "description": "Make a series on a five-field cron schedule (`--cron`), such as `*/15 9-18 * * 1-5` or `0 9 * * *`; minute hour day month weekday, single spaces. Unbounded unless `until` or `max_runs`; not with `every`, `kind`, `hold` or a recheck.",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9*/,?#-]+( [A-Za-z0-9*/,?#-]+){4}$"
        },
        "tz": {
          "type": "string",
          "description": "IANA time zone of `cron` (`--tz`), such as `Europe/Moscow`; default the hive's owner zone. Only with `cron`.",
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]{0,31}(/[A-Za-z0-9_+-]{1,32}){0,2}$"
        },
        "until": {
          "type": "string",
          "description": "No period of the series starts at or after this time (`--until`): RFC 3339 with an offset. Only with `every` or `cron`.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "max_runs": {
          "type": "integer",
          "description": "At most this many cards of the series (`--max-runs`). Only with `every` or `cron`.",
          "minimum": 1,
          "maximum": 10000
        },
        "recheck_every": {
          "type": "string",
          "description": "After the card is done, run its acceptance again every this long (`--recheck-every`), `Ns`, `Nm`, `Nh` or `Nd` up to 366 days; a failed recheck blocks the card and reports it. Needs `recheck_until` or `recheck_max`; not with `every` or `cron`.",
          "pattern": "^[1-9][0-9]{0,6}[smhd]$"
        },
        "recheck_until": {
          "type": "string",
          "description": "No recheck at or after this time (`--recheck-until`): RFC 3339 with an offset. Only with `recheck_every`.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "recheck_max": {
          "type": "integer",
          "description": "At most this many rechecks (`--recheck-max`). Only with `recheck_every`.",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "title",
        "goal",
        "step",
        "source"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "acceptance"
          ]
        },
        {
          "required": [
            "accept_review"
          ]
        }
      ]
    },
    "CardStatus": {
      "type": "object",
      "description": "Current status of a card.",
      "properties": {
        "card_id": {
          "type": "string",
          "description": "Card id."
        },
        "state": {
          "type": "string",
          "description": "Card state (see C3 `CardState`)."
        },
        "round": {
          "type": "integer",
          "description": "Current round.",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "description": "The card's title.",
          "maxLength": 200
        },
        "result_line": {
          "type": "string",
          "description": "First line of the card's result once it has one (the outcome, a block or a cancel reason), at most 500 characters.",
          "maxLength": 500
        },
        "report_line": {
          "type": "string",
          "description": "First line of the last head report, at most 500 characters.",
          "maxLength": 500
        }
      },
      "required": [
        "card_id",
        "state",
        "round"
      ],
      "additionalProperties": false
    },
    "HiveListInput": {
      "type": "object",
      "description": "List cards.",
      "properties": {
        "state": {
          "type": "string",
          "description": "Filter by state; without it cancelled cards are left out.",
          "enum": [
            "created",
            "queued",
            "running",
            "check",
            "review",
            "done",
            "blocked",
            "cancelled"
          ]
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of cards; default 20.",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "HiveListOutput": {
      "type": "object",
      "description": "Card list.",
      "properties": {
        "cards": {
          "type": "array",
          "description": "Cards, newest first.",
          "items": {
            "$ref": "#/$defs/CardStatus"
          }
        }
      },
      "required": [
        "cards"
      ],
      "additionalProperties": false
    },
    "HiveSteerInput": {
      "type": "object",
      "description": "Send a steering note to the head working on a card.",
      "properties": {
        "card_id": {
          "type": "string",
          "description": "Card id, e.g. `h_48b892d9`.",
          "pattern": "^h_[0-9a-f]{8}$"
        },
        "note": {
          "type": "string",
          "description": "Note text the head gets in its session or its next round.",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "card_id",
        "note"
      ],
      "additionalProperties": false
    },
    "HiveCancelInput": {
      "type": "object",
      "description": "Cancel a card; its active heads are stopped.",
      "properties": {
        "card_id": {
          "type": "string",
          "description": "Card id, e.g. `h_48b892d9`.",
          "pattern": "^h_[0-9a-f]{8}$"
        },
        "reason": {
          "type": "string",
          "description": "Why, kept on the card.",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "card_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "GardenSearchInput": {
      "type": "object",
      "description": "Search the garden.",
      "properties": {
        "q": {
          "type": "string",
          "description": "Query.",
          "minLength": 1
        },
        "k": {
          "type": "integer",
          "description": "Number of facts.",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "q"
      ],
      "additionalProperties": false
    },
    "GardenSearchOutput": {
      "type": "object",
      "description": "Garden search result.",
      "properties": {
        "facts": {
          "type": "array",
          "description": "Facts, best first.",
          "items": {
            "$ref": "#/$defs/GardenFact"
          }
        }
      },
      "required": [
        "facts"
      ],
      "additionalProperties": false
    },
    "GardenFact": {
      "type": "object",
      "description": "A fact as returned to the agent (same shape as C7 `Fact`).",
      "properties": {
        "fact": {
          "type": "string",
          "description": "Fact text."
        },
        "entity": {
          "type": "string",
          "description": "Entity the fact is about."
        },
        "source_ref": {
          "type": "string",
          "description": "Reference to the source."
        },
        "score": {
          "type": "number",
          "description": "Relevance score.",
          "minimum": 0
        }
      },
      "required": [
        "fact",
        "entity",
        "source_ref",
        "score"
      ],
      "additionalProperties": false
    },
    "GardenProposeInput": {
      "type": "object",
      "description": "Propose a new fact.",
      "properties": {
        "fact": {
          "type": "string",
          "description": "Fact text.",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "description": "Entity."
        },
        "source_ref": {
          "type": "string",
          "description": "Reference to the evidence."
        }
      },
      "required": [
        "fact",
        "entity",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "InboxAckInput": {
      "type": "object",
      "description": "Acknowledge an inbox event (C1).",
      "properties": {
        "id": {
          "type": "string",
          "description": "Event id.",
          "pattern": "^[a-zA-Z0-9:_-]{1,96}$"
        },
        "outcome": {
          "type": "string",
          "description": "Outcome (C1 `AckOutcome`).",
          "enum": [
            "success",
            "silent",
            "uncertain",
            "deferred"
          ]
        }
      },
      "required": [
        "id",
        "outcome"
      ],
      "additionalProperties": false
    },
    "GatePendingOutput": {
      "type": "object",
      "description": "Gate previews waiting for the owner.",
      "properties": {
        "previews": {
          "type": "array",
          "description": "Pending previews.",
          "items": {
            "$ref": "#/$defs/PendingPreview"
          }
        }
      },
      "required": [
        "previews"
      ],
      "additionalProperties": false
    },
    "PendingPreview": {
      "type": "object",
      "description": "One pending preview.",
      "properties": {
        "preview_id": {
          "type": "string",
          "description": "Preview id."
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 of the exact bytes shown.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "description": "Preview text."
        }
      },
      "required": [
        "preview_id",
        "sha256",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
